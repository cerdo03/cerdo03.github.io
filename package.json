{
  "name": "technical-journal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "html-validate index.html \"journal/*.html\" \"labs/**/*.html\" && stylelint styles.css \"assets/*.css\" && stylelint \"labs/**/*.css\" --config stylelint-learning.json && eslint \"assets/*.js\" \"labs/**/*.js\" \"scripts/*.mjs\"",
    "test": "node --test tests/*.test.mjs",
    "test:architecture:browser": "node scripts/qa-architecture.mjs",
    "preview:architecture": "python3 -m http.server 4192 --bind 127.0.0.1"
  },
  "devDependencies": {
    "eslint": "10.0.0",
    "html-validate": "10.1.0",
    "playwright": "1.64.1",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
